# Server-only keys. Never prefix these with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_PROVIDER_ORDER=gemini
VISION_PROVIDER_ORDER=gemini
AI_PROVIDER_TIMEOUT_MS=45000
# Enable Fact Check Tools API for this key's Google Cloud project.
GOOGLE_FACT_CHECK_API_KEY=
DATABASE_URL=
SATYACHECK_MAX_CLAIMS=2
SATYACHECK_QUERIES_PER_CLAIM=2
SATYACHECK_RATE_LIMIT=5
# Optional local text fallback: AI_PROVIDER_ORDER=gemini,ollama
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_BASE_URL=http://localhost:11434/v1

