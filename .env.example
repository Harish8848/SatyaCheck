# Database
DATABASE_URL=

# Optional Gemini fallback
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Grok API (Grok is provided by xAI)
GROK_API_KEY=
GROK_MODEL=grok-4.7
GROK_BASE_URL=https://api.x.ai/v1

# Local-first AI (install Ollama separately; pull both models below)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2:3b
VISION_PROVIDER_ORDER=ollama/qwen3-vl:8b,gemini
# Optional transcription CLI: whisper (openai-whisper); defaults to tiny model
WHISPER_MODEL=tiny

AI_PROVIDER_ORDER=ollama,gemini
AI_PROVIDER_TIMEOUT_MS=30000
RESEARCH_PROVIDER_TIMEOUT_MS=5000
